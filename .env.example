APP_NAME="ManzomaTech ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPEN_EXCHANGE_RATES_APP_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TRANSLATION_DRIVER=libretranslate
LIBRETRANSLATE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT=10
# "mock" uses the built-in fake checkout, "live" talks to Paymob.
PAYMOB_MODE=mock
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
# Card-on-file (MOTO) integration used to charge saved cards on renewal.
PAYMOB_MOTO_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_INTENTION_URL=https://accept.paymob.com/v1/intention/
PAYMOB_CHECKOUT_URL=https://accept.paymob.com/unifiedcheckout/
PAYMOB_CURRENCY=EGP
PAYMOB_TIMEOUT=30

SUBSCRIPTION_RENEWAL_WINDOW_HOURS=72
SUBSCRIPTION_GRACE_DAYS=5
SUBSCRIPTION_RETRY_ATTEMPTS=3
SUBSCRIPTION_RETRY_INTERVAL_HOURS=24
SUBSCRIPTION_CHECKOUT_TTL_MINUTES=60
SUBSCRIPTION_CHECKOUT_RETURN_PATH=/checkout/{reference}
FRONTEND_URL=http://localhost:5173

ERP_API_RATE_LIMIT=60
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Each company connects with their own Meta App ID/Secret and webhook verify
# token from their company profile -> Meta Integration, so no platform-wide
# META_APP_ID/META_APP_SECRET/META_WEBHOOK_VERIFY_TOKEN exists here.
# Each company saves its own TikTok App ID/Secret from their company profile,
# so no platform-wide TIKTOK_APP_ID/TIKTOK_APP_SECRET exists here.
TIKTOK_REDIRECT_URI=http://localhost:5173/auth/tiktok/callback
TIKTOK_API_VERSION=v1.3
TIKTOK_AUTH_URL=https://ads.tiktok.com/marketing_api/auth
TIKTOK_WEBHOOK_SECRET=
TIKTOK_REQUEST_RETRIES=3
TIKTOK_TOKEN_REFRESH_LEAD_DAYS=7

META_GRAPH_VERSION=v21.0
META_REDIRECT_URI=http://localhost:5173/auth/facebook/callback
SENTRY_LARAVEL_DSN=
